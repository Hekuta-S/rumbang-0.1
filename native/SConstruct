#!/usr/bin/env python
# Extensión nativa de Rumbang (GDExtension, godot-cpp). Compilar desde native/:
#   python -m SCons platform=windows use_mingw=yes use_llvm=yes target=template_debug
#   python -m SCons platform=android arch=arm64 target=template_debug     (y target=template_release)
# Las bibliotecas salen en res://bin/ y las carga res://bin/rumbang_native.gdextension.
env = SConscript("godot-cpp/SConstruct", {"api_version": "4.7"})
env.Append(CPPPATH=["src/"])
sources = Glob("src/*.cpp")
library = env.SharedLibrary(
    "../bin/librumbang_native{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
    source=sources,
)
env.NoCache(library)
Default(library)
